# Copies the dds3 extension into its package directory. dds has the same
# genrules, but its :_dds3_in_package alias is private. Without this, the
# wheel ships dds3/__init__.py without dds3/_dds3.so, which fails on the
# first call.
genrule(
    name = "_dds3_in_package_unix",
    srcs = ["@dds//python:_dds3"],
    outs = ["dds3/_dds3.so"],
    cmd = "cp \"$(location @dds//python:_dds3)\" \"$@\"",
)

genrule(
    name = "_dds3_in_package_windows",
    srcs = ["@dds//python:_dds3"],
    outs = ["dds3/_dds3.pyd"],
    cmd = "cp \"$(location @dds//python:_dds3)\" \"$@\"",
    cmd_bat = "copy /Y \"$(location @dds//python:_dds3)\" \"$@\"",
)

alias(
    name = "_dds3_in_package",
    actual = select({
        "//:build_windows": ":_dds3_in_package_windows",
        "//conditions:default": ":_dds3_in_package_unix",
    }),
)

# One wheel, two top-level imports: dds3 and belief_space_local_evaluation.
# Both extensions link the same static solver, so two wheels would duplicate
# it. Every caller needs both anyway, because __init__.py imports dds3.
py_wheel(
    name = "rbe_wheel",
    distribution = "rbe",
    version = "0.1.0",
    summary = "Replenished belief evaluation for bridge declarer play, with the dds double dummy solver",
    homepage = "https://github.com/zzcgumn/rbe",
    license = "Apache-2.0",
    python_requires = ">=3.10",
    # NOTE: tagged py3-none-any, although it ships compiled extensions. So
    # pip installs it on platforms where it cannot import. dds has the same
    # problem. The fix needs real python/abi/platform tags, which is a
    # decision about which platforms to publish.
    deps = [
        ":belief_space_local_evaluation_lib",
        ":_belief_space_local_evaluation_in_package",
        ":bridge_notation_lib",
        "@dds//python:dds3_lib",
        ":_dds3_in_package",
    ],
    strip_path_prefixes = ["python/"],
    entry_points = {},
)

# Guard: the wheel must hold both packages and both compiled extensions.
# py_wheel packages srcs, not data. A wheel without dds3/_dds3.so builds,
# installs and imports, then fails on the first call.
py_test(
    name = "wheel_contents_test",
    size = "small",
    main = "tests/test_wheel_contents.py",
    srcs = ["tests/test_wheel_contents.py"],
    data = [":rbe_wheel"],
)

py_wheel_dist(
    name = "rbe_wheel_dist",
    out = "dist",
    wheel = ":rbe_wheel",
)
