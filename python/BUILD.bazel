load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_python//python:packaging.bzl", "py_wheel", "py_wheel_dist")

pybind_extension(
    name = "_belief_space_local_evaluation",
    srcs = [
        "src/belief_converters.cpp",
        "src/belief_converters.hpp",
        "src/belief_space_local_evaluation.cpp",
        # The Deal converters, compiled in rather than linked. Only srcs get
        # -fvisibility=hidden. As a cc_library, their symbols would be
        # exported from both this .so and dds3's, and could clash at load
        # time.
        "@dds//python:converters_srcs",
    ],
    copts = DDS_CPPOPTS,
    deps = [
        # Puts converters.hpp on the include path as <dds3/converters.hpp>,
        # so that this extension's sources can include it.
        "@dds//python:converters_hdrs",
        # converters.hpp includes <dds/dds.hpp>.
        "@dds//library/src:dds",
        "//src/belief_evaluation",
        # The solver seam. These two link the solver; the rest of the
        # extension does not. dds3 registers SolverContext, so no dependency
        # on the dds3 extension is needed.
        "//src/belief_evaluation:double_dummy_bound",
        "//src/belief_evaluation:double_dummy_defender",
        # The heuristic defender: the rules (solver-free) and the defender
        # (calls the solver).
        "//src/belief_evaluation:defender_heuristic",
        "//src/belief_evaluation:heuristic_defender",
        # The lookahead declarer: the cache (solver-free) and the declarer
        # (calls the solver).
        "//src/belief_evaluation:brute_force_cache",
        "//src/belief_evaluation:brute_force_declarer",
    ],
    visibility = ["//visibility:public"],
)

# Copy the extension into the package directory under the platform-specific
# filename Python expects for native modules.
genrule(
    name = "_belief_space_local_evaluation_in_package_unix",
    srcs = [":_belief_space_local_evaluation"],
    outs = ["belief_space_local_evaluation/_belief_space_local_evaluation.so"],
    cmd = "cp \"$(location :_belief_space_local_evaluation)\" \"$@\"",
)

genrule(
    name = "_belief_space_local_evaluation_in_package_windows",
    srcs = [":_belief_space_local_evaluation"],
    outs = ["belief_space_local_evaluation/_belief_space_local_evaluation.pyd"],
    cmd = "cp \"$(location :_belief_space_local_evaluation)\" \"$@\"",
    cmd_bat = "copy /Y \"$(location :_belief_space_local_evaluation)\" \"$@\"",
)

alias(
    name = "_belief_space_local_evaluation_in_package",
    actual = select({
        "//:build_windows": ":_belief_space_local_evaluation_in_package_windows",
        "//conditions:default": ":_belief_space_local_evaluation_in_package_unix",
    }),
)

py_library(
    name = "belief_space_local_evaluation_lib",
    srcs = [
        "belief_space_local_evaluation/__init__.py",
        "belief_space_local_evaluation/play_sequence.py",
    ],
    data = [":_belief_space_local_evaluation_in_package"],
    imports = ["."],
    # __init__.py imports dds3 first, so that SolverContext is registered.
    # Both extensions use the same pybind11, so they share the type registry.
    deps = [
        "@dds//python:dds3_lib",
        # Imported by play_sequence.py.
        ":bridge_notation_lib",
    ],
    visibility = ["//visibility:public"],
)

# No dependencies. A top-level package, so that a caller who only formats a
# dds3 result need not import belief_space_local_evaluation.
py_library(
    name = "bridge_notation_lib",
    srcs = ["bridge_notation/__init__.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

