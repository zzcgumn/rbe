load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Runnable examples of the Python surface.
#
# `strategies.py` holds the heuristics that the examples use. It is private
# to this package, so that it does not become a supported API.

py_library(
    name = "example_support",
    srcs = [
        "strategies.py",
    ],
    imports = ["."],
    deps = [
        "//python:belief_space_local_evaluation_lib",
        "//python:bridge_notation_lib",
        # The solver seam: double_dummy_defender() constructs a
        # DoubleDummyDefender, which takes a dds3.SolverContext.
        "@dds//python:dds3_lib",
    ],
)

# The example is a library, so that the binary and both tests can import it.
# A py_test should not depend on a py_binary.
py_library(
    name = "guess_6nt_belief_space_lib",
    srcs = ["guess_6nt_belief_space.py"],
    imports = ["."],
    deps = [":example_support"],
)

py_binary(
    name = "guess_6nt_belief_space",
    srcs = ["run_guess_6nt_belief_space.py"],
    main = "run_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

py_test(
    name = "guess_6nt_belief_space_test",
    size = "small",
    srcs = ["test_guess_6nt_belief_space.py"],
    main = "test_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

# Tests the strategies.py templates, and checks them against the
# evaluator's follow-suit rule.
py_test(
    name = "strategies_test",
    size = "small",
    srcs = ["test_strategies.py"],
    main = "test_strategies.py",
    deps = [":guess_6nt_belief_space_lib"],
)

py_library(
    name = "restricted_choice_6nt_lib",
    srcs = ["restricted_choice_6nt_belief_space.py"],
    imports = ["."],
    deps = [
        # Imported directly, so listed directly
        # (.github/instructions/bazel.instructions.md).
        "//python:belief_space_local_evaluation_lib",
        "//python:bridge_notation_lib",
        "@dds//python:dds3_lib",
        ":example_support",
    ],
)

py_binary(
    name = "restricted_choice_6nt",
    srcs = ["run_restricted_choice_6nt.py"],
    main = "run_restricted_choice_6nt.py",
    deps = [":restricted_choice_6nt_lib"],
)

py_test(
    name = "restricted_choice_6nt_test",
    size = "small",
    srcs = ["test_restricted_choice_6nt.py"],
    main = "test_restricted_choice_6nt.py",
    deps = [
        # The test imports these directly too.
        "//python:bridge_notation_lib",
        "@dds//python:dds3_lib",
        ":example_support",
        ":restricted_choice_6nt_lib",
    ],
)
