load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Runnable examples. Nothing here is part of the library: these are the
# scripts a new caller reads first, and the small amount of bridge plumbing
# (notation, trick mechanics) they need that the library itself has no
# reason to carry.
#
# No target here is visible outside this package, deliberately. The plumbing
# is not reusable API: it is bridge notation and the trick bookkeeping one
# example needs, and a second caller depending on it would turn a convenience
# into a contract. The trick *mechanics* used to be here too, re-implemented
# from src/belief_evaluation/trick.hpp because they were not bound to Python;
# they are bound now, and play_sequence calls them.

py_library(
    name = "example_support",
    srcs = [
        "bridge_notation.py",
        "play_sequence.py",
        "strategies.py",
    ],
    imports = ["."],
    deps = [
        "//python:belief_space_local_evaluation_lib",
        # The solver seam: double_dummy_defender() constructs a
        # DoubleDummyDefender, which takes a dds3.SolverContext.
        "@dds//python:dds3_lib",
    ],
)

# The example as a library, so the binary and both tests import one module
# rather than a py_test depending on a py_binary.
py_library(
    name = "guess_6nt_belief_space_lib",
    srcs = ["guess_6nt_belief_space.py"],
    imports = ["."],
    deps = [":example_support"],
)

py_binary(
    name = "guess_6nt_belief_space",
    srcs = ["run_guess_6nt_belief_space.py"],
    main = "run_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

py_test(
    name = "guess_6nt_belief_space_test",
    size = "small",
    srcs = ["test_guess_6nt_belief_space.py"],
    main = "test_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

# The bridge plumbing, tested directly rather than only through the one deal.
# It no longer re-implements trick.hpp -- see the file's own docstring for what
# it still owns, and why that part is worth testing on its own.
py_test(
    name = "play_sequence_test",
    size = "small",
    srcs = ["test_play_sequence.py"],
    main = "test_play_sequence.py",
    deps = [":guess_6nt_belief_space_lib"],
)
