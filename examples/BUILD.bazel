load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Runnable examples. `bridge_notation` and `PlaySequence`
# (`belief_space_local_evaluation.play_sequence`) used to live here too, but
# neither is example-specific: both are general bridge plumbing, reusable by
# anyone who installs this library, so both were promoted to the installed
# package -- see python/BUILD.bazel's `bridge_notation_lib` and
# `belief_space_local_evaluation_lib`.
#
# `strategies.py` is the one thing left deliberately private to this package.
# It is this one example's own declarer/defender heuristics
# (`lowest_eligible_declarer`, the belief-finesse declarer,
# `queen_of_spades_when_it_wins`), not general bridge plumbing -- a second
# caller depending on it would turn a one-example convenience into a
# contract this package never intended to support.

py_library(
    name = "example_support",
    srcs = [
        "strategies.py",
    ],
    imports = ["."],
    deps = [
        "//python:belief_space_local_evaluation_lib",
        "//python:bridge_notation_lib",
        # The solver seam: double_dummy_defender() constructs a
        # DoubleDummyDefender, which takes a dds3.SolverContext.
        "@dds//python:dds3_lib",
    ],
)

# The example as a library, so the binary and both tests import one module
# rather than a py_test depending on a py_binary.
py_library(
    name = "guess_6nt_belief_space_lib",
    srcs = ["guess_6nt_belief_space.py"],
    imports = ["."],
    deps = [":example_support"],
)

py_binary(
    name = "guess_6nt_belief_space",
    srcs = ["run_guess_6nt_belief_space.py"],
    main = "run_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

py_test(
    name = "guess_6nt_belief_space_test",
    size = "small",
    srcs = ["test_guess_6nt_belief_space.py"],
    main = "test_guess_6nt_belief_space.py",
    deps = [":guess_6nt_belief_space_lib"],
)

# strategies.py's templates and its cross-check against the evaluator's own
# follow-suit rule -- the two things this package still tests directly,
# now that play_sequence.py and bridge_notation.py's own tests moved with
# them to python/tests/.
py_test(
    name = "strategies_test",
    size = "small",
    srcs = ["test_strategies.py"],
    main = "test_strategies.py",
    deps = [":guess_6nt_belief_space_lib"],
)

py_library(
    name = "restricted_choice_6nt_lib",
    srcs = ["restricted_choice_6nt_belief_space.py"],
    imports = ["."],
    deps = [":example_support"],
)

py_binary(
    name = "restricted_choice_6nt",
    srcs = ["run_restricted_choice_6nt.py"],
    main = "run_restricted_choice_6nt.py",
    deps = [":restricted_choice_6nt_lib"],
)

py_test(
    name = "restricted_choice_6nt_test",
    size = "small",
    srcs = ["test_restricted_choice_6nt.py"],
    main = "test_restricted_choice_6nt.py",
    deps = [":restricted_choice_6nt_lib"],
)
