load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")

# The pi and delta timer.cpp times. Header-only, like
# benchmarks/belief_evaluation:strategies. See strategies.hpp for why it is
# not in tests/belief_evaluation/test_support.hpp.
cc_library(
    name = "strategies",
    hdrs = ["strategies.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# Tests real_work_declarer_play() on a hand-derived case, independent of
# any fixture or evaluate() call (see the source file).
cc_test(
    name = "safety_score_declarer_play_test",
    size = "small",
    srcs = ["safety_score_declarer_play_test.cpp"],
    deps = [
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The C++ side of the Python-against-C++ callback cost comparison (see
# timer.cpp). Not tagged manual, so `bazel test //...` builds it but never
# runs it; report.py runs it. Solver-free.
cc_binary(
    name = "timer_cpp",
    srcs = ["timer.cpp"],
    deps = [
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The Python side of the same comparison, through the compiled binding.
# It needs the build and runfiles wiring of
# belief_space_local_evaluation_lib, so it is a py_binary, not a plain
# script like the sweep scripts in benchmarks/belief_evaluation. A
# py_binary is not a test, so `bazel test //...` never runs it.
py_binary(
    name = "timer_py",
    srcs = ["timer.py"],
    main = "timer.py",
    deps = ["//python:belief_space_local_evaluation_lib"],
)

# Runs both timers and tabulates the ratio, in one command. Both timers
# are data deps, so `bazel run //benchmarks/python_cost:report` builds and
# finds them.
py_binary(
    name = "report",
    srcs = ["report.py"],
    main = "report.py",
    data = [
        ":timer_cpp",
        ":timer_py",
    ],
    deps = ["@rules_python//python/runfiles"],
)
