load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# The scripted, solver-free strategy pair every fixture, guard and
# instrument here uses by default. See strategies.hpp for why it is not in
# test_support.hpp.
cc_library(
    name = "strategies",
    hdrs = ["strategies.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The fixture ladder every benchmark and guard here measures on (see
# fixtures.hpp). Solver-free: it needs only scripted strategies, like the
# core C++ tests.
cc_library(
    name = "fixtures",
    srcs = ["fixtures.cpp"],
    hdrs = ["fixtures.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The size guard: if a fixture's size() drifts, every benchmark number on
# it is silently wrong. It runs in the default test cycle, in both build
# modes, because it is fast (including the exhaustive evaluate() calls on
# the bottom two rungs). It links the solver for the solver ladder's
# SolveBoardAcceptsTheRootLayout guard. Benchmark targets may; the core
# library may not.
cc_test(
    name = "fixtures_test",
    size = "small",
    srcs = ["fixtures_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
        "@dds//library/src/solver_context",
        "@dds//library/src:dds",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# Not a test target. The Python fixture-ladder test runs this program,
# which prints every rung as Python literals (see the source file).
# Solver-free, with the same deps as :fixtures.
cc_binary(
    name = "ladder_reference",
    srcs = ["ladder_reference.cpp"],
    deps = [
        ":fixtures",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    visibility = ["//python:__pkg__"],
)

# The measuring instrument. It runs one fixture through evaluate() with a
# chosen seed, sample size and replenishment threshold, and prints raw
# counters, timing, an uncut node count or a spread-policy divergence
# count. Not tagged manual, so `bazel test //...` builds it everywhere but
# never runs it; the sweep scripts run it.
#
# It depends on the solver for --strategy double_dummy, --tier2 and
# --mode=divergence: double_dummy_defender, double_dummy_bound,
# solver_context, and @dds//library/src:dds for solve_board.hpp
# (--mode=divergence calls solve_board directly). This target may link the
# solver; the core library must not.
cc_binary(
    name = "instrument",
    srcs = ["instrument.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        ":uncut_tree",
        "//src/belief_evaluation",
        "//src/belief_evaluation:double_dummy_bound",
        "//src/belief_evaluation:double_dummy_defender",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/solver_context",
        "@dds//library/src:dds",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The node count with tier 1 and tier 2 both removed. evaluate() cannot
# report it, because no option disables already_made() or is_dead(). Built
# from evaluate()'s public pieces, so nothing under src/ changes (see
# uncut_tree.hpp).
cc_library(
    name = "uncut_tree",
    srcs = ["uncut_tree.cpp"],
    hdrs = ["uncut_tree.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# Tests count_uncut_nodes(): a real evaluate() call must visit no more
# nodes than it counts, on the ladders where that holds.
cc_test(
    name = "uncut_tree_test",
    size = "small",
    srcs = ["uncut_tree_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        ":uncut_tree",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The fast correctness guard beside the instrument. It checks only what is
# deterministic: the same seed gives the same answer bitwise;
# sample_size >= size() reproduces the exhaustive run; the mass-conservation
# asserts survive sampling and replenishment (in the default build, where
# they are live). Runs in the default test cycle, in both build modes.
cc_test(
    name = "instrument_guard_test",
    size = "small",
    srcs = ["instrument_guard_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)
