load("//:CPPVARIABLES.bzl", "DDS_CPPOPTS", "DDS_LINKOPTS", "DDS_LOCAL_DEFINES")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# The scripted (solver-free) declarer/defender strategy pair every fixture,
# guard, and instrument under this directory shares by default -- see
# strategies.hpp's own module doxygen for why it is not folded into
# test_support.hpp instead.
cc_library(
    name = "strategies",
    hdrs = ["strategies.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The fixture ladder every benchmark and its correctness guard under this
# directory measures on -- see fixtures.hpp's own module doxygen. Solver-free:
# nothing here needs solve_board, only the scripted strategies this
# capability's own C++ test suite already uses (test_support.hpp's
# precedent), matching //src/belief_evaluation's own deps below.
cc_library(
    name = "fixtures",
    srcs = ["fixtures.cpp"],
    hdrs = ["fixtures.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The size guard: a fixture whose size() drifts silently invalidates every
# number the tasks after this one report. In the default test cycle, both
# build modes -- unlike the benchmarks themselves, this is fast enough to
# run every time (the bottom two rungs' own exhaustive evaluate() calls
# included). Links the solver (for the solver ladder's own
# SolveBoardAcceptsTheRootLayout guard) -- permitted here for the same
# reason as :instrument, not for the core library itself.
cc_test(
    name = "fixtures_test",
    size = "small",
    srcs = ["fixtures_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
        "@dds//library/src/solver_context",
        "@dds//library/src:dds",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# Not a test target: a plain program, invoked as a subprocess by the
# Python-side fixture ladder test, that prints every rung to stdout as
# Python literals -- see the source file's own header comment. Solver-free,
# same deps as :fixtures above.
cc_binary(
    name = "ladder_reference",
    srcs = ["ladder_reference.cpp"],
    deps = [
        ":fixtures",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    visibility = ["//python:__pkg__"],
)

# The measuring instrument: runs one fixture through evaluate() with a
# caller-chosen seed/sample-size/replenishment threshold and prints raw
# counters, timing, an uncut node count, or a spread-policy divergence
# count. Not tagged manual, so `bazel test //...` builds it everywhere and
# never runs it -- running it is the several-seeds x several-sample-sizes x
# several-fixtures sweep the tasks after this one do, not a test. Depends
# on the solver (double_dummy_defender, double_dummy_bound, solver_context,
# and @dds//library/src:dds itself for solve_board.hpp -- --mode=divergence
# calls solve_board directly, the same call double_dummy_defender.cpp
# makes) for --strategy double_dummy, --tier2 and --mode=divergence --
# explicitly permitted for this target even though the core library itself
# must stay solver-free (see uncut_tree's own comment on the same
# distinction).
cc_binary(
    name = "instrument",
    srcs = ["instrument.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        ":uncut_tree",
        "//src/belief_evaluation",
        "//src/belief_evaluation:double_dummy_bound",
        "//src/belief_evaluation:double_dummy_defender",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/solver_context",
        "@dds//library/src:dds",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# How many nodes the search tree would have with tier 1 and tier 2 both
# removed -- see uncut_tree.hpp's own module doxygen for why evaluate()
# itself cannot answer that (already_made()/is_dead() are unconditional,
# no EvaluateOptions flag disables either) and why this needs no change
# under src/ regardless (built from the same public pieces evaluate()
# itself is built from).
cc_library(
    name = "uncut_tree",
    srcs = ["uncut_tree.cpp"],
    hdrs = ["uncut_tree.hpp"],
    visibility = ["//benchmarks:__subpackages__"],
    deps = [
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@dds//library/src/api:dds_constants",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# count_uncut_nodes()'s own correctness: the one property it must always
# have, a real evaluate() call visiting fewer or equal nodes, never more.
cc_test(
    name = "uncut_tree_test",
    size = "small",
    srcs = ["uncut_tree_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        ":uncut_tree",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)

# The fast correctness guard beside the instrument above: only what is
# deterministic (same seed -> same answer bitwise; sample_size >= size()
# reproduces the exhaustive run exactly; the mass-conservation asserts
# survive real sampling and replenishment on these bigger fixtures, in the
# default build where those asserts are live). In the default test cycle,
# both build modes.
cc_test(
    name = "instrument_guard_test",
    size = "small",
    srcs = ["instrument_guard_test.cpp"],
    deps = [
        ":fixtures",
        ":strategies",
        "//src/belief_evaluation",
        "@dds//library/src/api:api_definitions",
        "@googletest//:gtest_main",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
)
