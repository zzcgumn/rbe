# Not a test target: a plain program, invoked as a subprocess by the
# Python bindings' own parity test (python/tests/test_belief_space_local_evaluation_parity.py),
# that builds a handful of fixtures, runs the real evaluator over them, and
# prints both to stdout as Python literals -- see the source file's own
# header comment for why this exists. Solver-free, same deps as
# belief_evaluation_test above.
cc_binary(
    name = "parity_reference",
    srcs = [
        "parity_reference.cpp",
        "test_support.hpp",
    ],
    deps = [
        "//library/src/belief_evaluation",
        "//library/src/belief_evaluation:position",
        "//library/src/lookup_tables",
        "//library/src/api:api_definitions",
        "//library/src/utility:constants",
        # test_support.hpp's own #include <gtest/gtest.h> (for the
        # EXPECT_*-based fixture-validation helpers this binary does not
        # call) -- gtest, not gtest_main, since this binary defines its
        # own main() and linking gtest_main too would conflict.
        "@googletest//:gtest",
    ],
    copts = DDS_CPPOPTS,
    linkopts = DDS_LINKOPTS,
    local_defines = DDS_LOCAL_DEFINES,
    visibility = ["//python:__pkg__"],
)

# Separate from belief_evaluation_test above so that target does not link
